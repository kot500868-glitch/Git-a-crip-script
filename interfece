local function refreshRoute()
    local lines = {}

    for i, point in ipairs(route) do
        table.insert(lines, string.format(
            "%d) X %.1f | Y %.1f | Z %.1f",
            i,
            point.X,
            point.Y,
            point.Z
        ))
    end

    if #lines == 0 then
        routeList.Text = "Маршрут пуст.\nДобавь текущую позицию."
    else
        routeList.Text = table.concat(lines, "\n")
    end
end

