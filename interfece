--// Movement
local function moveToPoint(point)
    local humanoid = getHumanoid()
    local root = getRoot()

    humanoid:MoveTo(point)

    local finished = false
    local connection

    connection = humanoid.MoveToFinished:Connect(function()
        finished = true
        connection:Disconnect()
    end)

    local started = os.clock()

    while routeRunning and not finished do
        if os.clock() - started > SETTINGS.MoveTimeout then
            break
        end
task.wait(0.1)
    end

    if connection then
        connection:Disconnect()
    end

    task.wait(SETTINGS.WaypointDelay)
end

local function runRoute()
    if routeRunning then
        return
    end

    if #route == 0 then
        warn("Сначала добавь точки маршрута.")
        return
    end

    routeRunning = true

    task.spawn(function()
        repeat
            for _, point in ipairs(route) do
                if not routeRunning then
                    break
                end

                moveToPoint(point)
            end
        until not routeRunning or not loopRoute

        routeRunning = false
    end)
end

