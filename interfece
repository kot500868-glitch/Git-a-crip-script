createCorner(routeList, 10)

local routeListLayout = Instance.new("UIListLayout")
routeListLayout.Padding = UDim.new(0, 5)
routeListLayout.Parent = routeList

local function refreshRouteList()
    for _, child in ipairs(routeList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    routeCountLabel.Text = "Всего точек: " .. #route

    for index, point in ipairs(route) do
local pointButton = createButton(
            routeList,
            string.format(
                "Точка %d   X %.1f   Y %.1f   Z %.1f",
                index,
                point.X,
                point.Y,
                point.Z
            ),
            UDim2.new(1, -10, 0, 38),
            UDim2.new(),
            selectedPoint == index
                and COLORS.ButtonSelected
                or COLORS.Button
        )

        pointButton.LayoutOrder = index

        pointButton.MouseButton1Click:Connect(function()
            selectedPoint = index
            refreshRouteList()
        end)
    end

    routeList.CanvasSize = UDim2.fromOffset(
        0,
        routeListLayout.AbsoluteContentSize.Y + 10
    )
end

addPageButton(
    routePage,
    "Добавить текущую позицию",
    COLORS.Green,
    function()
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if root then
            table.insert(route, root.Position)
            selectedPoint = #route
            refreshRouteList()
        end
    end
)

addPageButton(
    routePage,
    "Удалить выбранную точку",
    COLORS.Red,
    function()
        if selectedPoint and route[selectedPoint] then
            table.remove(route, selectedPoint)

            if #route == 0 then
                selectedPoint = nil
            else
                selectedPoint = math.clamp(selectedPoint, 1, #route)
            end

            refreshRouteList()
        end
    end
)

addPageButton(
    routePage,
    "Очистить маршрут",
    COLORS.Red,
    function()
        table.clear(route)
        selectedPoint = nil
        refreshRouteList()
    end
)

